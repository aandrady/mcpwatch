[Unit]
Description=MCPWatch corpus health check
Documentation=https://github.com/aandrady/mcpwatch
# Ordering only, and it is what lets this judge the night it runs for. A timer
# at a fixed hour races any cycle that runs long: on 2026-09-07/08 the manifest
# probe was still going at 06:00, so each check graded the previous day's run and
# the one cycle cut short was never looked at. After= holds this start job until
# both have finished, as the backup's own After= already does. Not Requires=: a
# failed collector is exactly when this must still run.
After=mcpwatch-manifest.service mcpwatch-backup.service

[Service]
Type=oneshot
WorkingDirectory=%h/code/mcpwatch
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=MCPWATCH_CORPUS=%h/mcpwatch-corpus
ExecStart=%h/.local/bin/uv run python -m mcpwatch.health

# A non-zero exit leaves this unit in a failed state, which surfaces in
# `systemctl --user list-units --failed` without needing a mail transport or an
# external alerting service. Detection matters more than automation here: a
# collector that dies quietly is the worst realistic outcome for this project.
TimeoutStartSec=600
Nice=15

# No [Install]: activated by its timer only.
