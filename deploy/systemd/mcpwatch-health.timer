[Unit]
Description=Daily MCPWatch corpus health check

[Timer]
# Nominally after the night's cycle and backup. The service's After= ordering,
# not this hour, is what guarantees it: a cycle still running at 06:00 holds the
# check until it ends, so a long night is judged when it finishes.
OnCalendar=*-*-* 06:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
